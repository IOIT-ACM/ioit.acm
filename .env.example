#SheetDB Credentials
FEEDBACK_FORM_API_URL=
FEEDBACK_FORM_BEARER_TOKEN=

MEMBERSHIP_FORM_API_URL=
MEMBERSHIP_FORM_BEARER_TOKEN=

ACM_RECRUITMENT_FORM_API_URL=
ACM_RECRUITMENT_FORM_BEARER_TOKEN=

# ACM Membership
ACM_MEMBERSHIP_SHEET_URL=

# Database
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Temperory variables, will be removed soon
WEB3_FORM_API_URL=
WEB3_FORM_BEARER_TOKEN=

CLOUD_FORM_API_URL=
CLOUD_FORM_BEARER_TOKEN=

SECRET_KEY=

# Rate limit storage. Leave empty locally to use in-memory storage.
# In production set it to Redis so every worker process shares the same
# counters, e.g. redis+unix:///home/<user>/redis/redis.sock (see README).
RATELIMIT_STORAGE_URI=

# Flask-Mail (Development SMTP using Mailpit)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Sign in with the chapter's Clerk instance (OpenID Connect). Leave empty to hide the button.
# IDP_DISCOVERY_URL defaults to https://clerk.auth.ioit.acm.org/.well-known/openid-configuration
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_DISCOVERY_URL=
# Admin access from Clerk organization roles. CLERK_SECRET_KEY is the sk_live_ key.
# IDP_ORG is the organization id (org_...) or slug. Admins have a role in
# IDP_ADMIN_ROLES (comma separated, default org:admin) or IDP_ADMIN_PERMISSION.
CLERK_SECRET_KEY=
IDP_ORG=
IDP_ADMIN_ROLES=
IDP_ADMIN_PERMISSION=
